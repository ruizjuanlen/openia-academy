<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — dark purple matching OpenIA Academy -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#6366f1</item>
        <item name="colorPrimaryDark">#0a0a14</item>
        <item name="colorAccent">#8b5cf6</item>
        <item name="android:statusBarColor">#6366f1</item>
        <item name="android:navigationBarColor">#0a0a14</item>
        <item name="android:windowBackground">#0a0a14</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#6366f1</item>
        <item name="android:navigationBarColor">#0a0a14</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">#0a0a14</item>
    </style>

</resources>